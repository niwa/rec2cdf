{
    "global": {
        "title": "TopNet spatial data for the {{name}} river",
        "comment": "TopNet spatial data, catchment {{name}}, created by rec2cdf, for REC reach: {{catchrchid}}",
        "river_basin": "{{name}}",
        "river_basin_id": {{catchrchid}},
        "network_aggregation_method": "strahler{{order}}",
        "note": "Index nrch count from 0!!!",
        "institution": "NIWA",
        "references": "",
        "source": "{{condsn}}",
        "conventions": "CF-1.0 with extensions",
        "file_creation_time": "{{now}}",
        "reference_geoid": "WGS84",
        "code_version": "{{code_version}}",
        "db_version": "{{db_version}}",
        "no_sub_catchments": {{no_sub_catchments}},
        "truncate_rchids": "{{truncate_rchids}}",
        "region": "{{region}}"
    },
    "station_vars": {
        "station": {
            "type": "i4",
            "dims": ["station"],
            "fillvalue": -9999,
            "attributes": {
                "station_type": "river flow station",
                "observed_variables": "Flow"
            }
        },
        "station_id": {
            "type": "i4",
            "dims": ["station"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "site number from TIDEDA database",
                "coordinates": "station_lat station_lon"
            }
        },
        "station_name": {
            "type": "S1",
            "dims": ["station", "station_name_length"],
            "attributes": {
                "long_name": "station name",
                "coordinates": "station_lat station_lon"
            }
        },
        "station_lat": {
            "type": "f8",
            "dims": ["station"],
            "fillvalue": -9999,
            "attributes": {
                "standard_name": "latitude",
                "long_name": "station latitude",
                "units": "degrees_north",
                "axis": "Y",
                "valid_min": -90.0,
                "valid_max": 90.0,
                "coordinates": "station_lat station_lon"
            }
        },
        "station_lon": {
            "type": "f8",
            "dims": ["station"],
            "fillvalue": -9999,
            "attributes": {
                "standard_name": "longitude",
                "long_name": "station longitude",
                "units": "degrees_east",
                "axis": "X",
                "valid_min": -180.0,
                "valid_max": 180.0,
                "coordinates": "station_lat station_lon"
            }
        },
        "station_altitude": {
            "type": "f8",
            "dims": ["station"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "station altitude",
                "standard_name": "surface_altitude",
                "units": "meter",
                "valid_min": 0.0,
                "valid_max": 9000.0,
                "coordinates": "station_lat station_lon"
            }
        },
        "station_rchid": {
            "type": "i4",
            "dims": ["station"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "river reach identifier related to station",
                "comment": "reach identifier (corresponds to variable rchid) of stream reach at which station is situated",
                "coordinates": "station_lat station_lon"
            }
        },
        "station_nrch": {
            "type": "i4",
            "dims": ["station"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "river reach index related to station",
                "comment": "reach index (corresponds to variable rchindex) of stream reach at which station is situated",
                "coordinates": "station_lat station_lon"
            }
        },
        "station_uparea": {
            "type": "f8",
            "dims": ["station"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "station upstream area",
                "units": "meter2",
                "valid_min": 100.0,
                "valid_max": 1e+17,
                "coordinates": "station_lat station_lon"
            }
        }
    },
    "flowstats_vars": {
        "qm": {
            "type": "i4",
            "dims": ["nrch"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "mean annual flood",
                "units": "meter3 second-1",
                "valid_min": 0,
                "valid_max": {{max_i4}},
                "coordinates": "end_lat end_lon",
                "scale_factor": 1e-3
            }
        },
        "qm_error": {
            "type": "i4",
            "dims": ["nrch"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "standard error of mean annual flood",
                "units": "meter3 second-1",
                "valid_min": 0,
                "valid_max": {{max_i4}},
                "coordinates": "end_lat end_lon",
                "scale_factor": 1e-3
            }
        },
        "q100": {
            "type": "i4",
            "dims": ["nrch"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "100-year flood",
                "units": "meter3 second-1",
                "valid_min": 0,
                "valid_max": {{max_i4}},
                "coordinates": "end_lat end_lon",
                "scale_factor": 1e-3
            }
        },
        "q100_error": {
            "type": "i4",
            "dims": ["nrch"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "standard error of 100-year flood",
                "units": "meter3 second-1",
                "valid_min": 0,
                "valid_max": {{max_i4}},
                "coordinates": "end_lat end_lon",
                "scale_factor": 1e-3
            }
        },
        "rch_minflow": {
            "type": "i4",
            "dims": ["nrch"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "Minimum environmental flow",
                "units": "meter3 second-1",
                "valid_min": 0,
                "valid_max": {{max_i4}},
                "coordinates": "end_lat end_lon",
                "scale_factor": 1e-3
            }
        }
    },
    "wetness_vars": {
        "lambda": {
            "type": "i4",
            "dims": ["nrch"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "lambda - average basin value of ln(a/tanb) distribution",
                "scale_factor": 0.1,
                "valid_min": 0,
                "valid_max": 300
            }
        },
        "numatan": {
            "type": "i4",
            "dims": ["nrch"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "number of points in ln(a/tanb) distribution",
                "scale_factor": 1,
                "valid_min": 0,
                "valid_max": {{maxbins}}
            }
        },
        "atanval": {
            "type": "i4",
            "dims": ["nrch", "maxbins"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "values of the ln(a/tanb) distribution",
                "valid_min": 0,
                "valid_max": 300, 
                "scale_factor": 0.1
            }
        },
        "atanfrq": {
            "type": "f8",
            "dims": ["nrch", "maxbins"],
            "fillvalue": -9999,
            "attributes": {
                "long_name": "cumulative frequencies of the ln(a/tanb) distribution",
                "units": "1",
                "valid_min": 0,
                "valid_max": 10000,
                "scale_factor": 0.0001
            }
        }
    },
